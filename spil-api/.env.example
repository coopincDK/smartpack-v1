# Kopiér denne fil til .env og udfyld rigtige værdier LOKALT.
# COMMIT ALDRIG .env — dette repo er OFFENTLIGT. .env står i .gitignore.

# Port serveren selv lytter på (ikke det samme som den offentlige port —
# se README.md/API.md for hvordan fase 2's docker-compose/nginx bruger den).
PORT=3000

# Postgres-forbindelsesstreng (brug en dedikeret app-rolle, ALDRIG
# Postgres-superbrugeren fra docker-compose.yml's db-service).
DATABASE_URL=postgres://spil:changeme@localhost:5432/spil

# --- Kun relevante for docker-compose.yml's db-service (postgres:16-image) ---
# Bootstrap-superbruger til selve containeren. Bruges IKKE af api-servicen
# (den bruger DATABASE_URL's egen, ikke-superbruger app-rolle ovenfor).
POSTGRES_USER=spil_super
POSTGRES_PASSWORD=changeme
POSTGRES_DB=spil

# App-rollens eget bruger/password — matcher DATABASE_URL ovenfor. Oprettes
# af et init-script i db-servicen (se scripts/init-db/ eller README) med kun
# de rettigheder appen skal bruge på POSTGRES_DB, IKKE superuser.
APP_DB_USER=spil_app
APP_DB_PASSWORD=changeme

# Bruges ikke af nuværende kode (src/config.js), men genereres/gemmes alligevel
# til fremtidig brug (fx sessions/cookies uden for admin-cookien).
SESSION_SECRET=
COOKIE_SECRET=

# Admin-adgangskode: gem KUN et scrypt-hash her, aldrig klartekst.
# Generér et hash med: node scripts/hash-password.js "din-adgangskode"
ADMIN_PASSWORD_HASH=

# Hvor længe en admin-session er gyldig (ms). Default: 12 timer.
ADMIN_SESSION_TTL_MS=43200000

# Sæt til "false" for at teste admin-login lokalt over almindelig http
# (uden dette vil browseren afvise en Secure-cookie over http).
# I produktion (https) skal denne ALTID være "true" (eller udeladt).
COOKIE_SECURE=true

NODE_ENV=production
